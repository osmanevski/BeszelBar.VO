+// handleStats handles the "stats" command: gather one round of system stats,
+// write them to stdout as JSON and exit. This is the path used by clients that
+// reach the machine directly over SSH rather than through the hub, so it must
+// not open a port, connect to a hub, or leave a process behind.
+//
+// An optional second argument overrides the sampling window, e.g. "stats 2s".
+func handleStats() {
+	window := agent.DefaultSnapshotWindow
+	if len(os.Args) > 2 {
+		parsed, err := time.ParseDuration(os.Args[2])
+		if err != nil {
+			log.Fatalf("Invalid sample window %q: %v", os.Args[2], err)
+		}
+		window = parsed
+	}
+
+	a, err := agent.NewAgent()
+	if err != nil {
+		log.Fatal("Failed to create agent: ", err)
+	}
+
+	// Logs go to stderr, so stdout carries nothing but the JSON document.
+	encoder := json.NewEncoder(os.Stdout)
+	encoder.SetIndent("", "  ")
+	if err := encoder.Encode(a.Snapshot(window)); err != nil {
+		log.Fatal("Failed to encode stats: ", err)
+	}
+}
+
 func fingerprintUsage() string {
 	return fmt.Sprintf("Usage: %s fingerprint [view|reset]\n\nCommands:\n  view   Print fingerprint (default)\n  reset  Reset saved fingerprint\n", os.Args[0])
 }
