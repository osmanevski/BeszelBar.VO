+package agent
+
+import (
+	"time"
+
+	"github.com/henrygd/beszel/internal/common"
+	"github.com/henrygd/beszel/internal/entities/system"
+)
+
+// DefaultSnapshotWindow is how long Snapshot waits before gathering, so that
+// delta-based metrics (cpu, network and disk I/O) have a meaningful interval.
+const DefaultSnapshotWindow = time.Second
+
+// Snapshot collects a single round of system stats and returns it.
+//
+// It exists for one-shot invocations that have no hub connection: the process
+// starts, samples once, prints and exits. The cpu, network and disk figures are
+// deltas against the counters recorded when the package was initialized, so a
+// process that gathers immediately would report a window of a few milliseconds.
+// Waiting for sampleWindow first gives those counters something to subtract.
+//
+// Memory and disk usage are point-in-time reads and are unaffected by the wait.
+func (a *Agent) Snapshot(sampleWindow time.Duration) *system.CombinedData {
+	if sampleWindow > 0 {
+		time.Sleep(sampleWindow)
+	}
+	return a.gatherStats(common.DataRequestOptions{
+		CacheTimeMs:    defaultDataCacheTimeMs,
+		IncludeDetails: true,
+	})
+}
